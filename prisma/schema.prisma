generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Business {
  id             String        @id @default(cuid())
  name           String
  description    String?
  phone          String?
  address        String?
  category       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  logoUrl        String?
  // URL pública de Supabase Storage (bucket "site-assets") — nunca se guarda
  // el binario ni un base64 acá. Ver lib/site-assets.ts: el path dentro del
  // bucket se deriva de esta URL cuando hace falta (reemplazo, limpieza de
  // huérfanos), así que no hace falta una columna aparte solo para el path.
  heroImageUrl   String?
  // Hex validado en el borde de entrada (ver HEX_COLOR_RE en
  // lib/brand-color.ts) antes de guardarse — nunca se usa un valor crudo del
  // cliente directamente como CSS custom property.
  brandColor     String?
  whatsappNumber String?
  instagramUrl   String?
  facebookUrl    String?
  // URL pública en /s/[slug]. Se genera una sola vez a partir del nombre (ver
  // modules/business/slug.ts) y a propósito NUNCA se regenera sola si el
  // nombre cambia después — cambiar el slug rompería la URL pública ya
  // compartida/indexada. Nullable porque los negocios creados antes de esta
  // feature no tienen uno hasta que se genera de forma perezosa.
  slug           String?       @unique
  appointments   Appointment[]
  employee       Employee?
  faqs           FAQ[]
  memberships    Membership[]
  memoryEntries  MemoryEntry[]
  resources      Resource[]
  schedules      Schedule[]
  services       Service[]
  trainingPlan   TrainingPlan?
  trainingConversations TrainingConversation[]
  seoConfig      SeoConfig?
}

// Configuración SEO generada por IA a partir de datos reales del negocio —
// nunca se genera en el request público (ver app/s/[slug]/page.tsx), solo se
// LEE ahí. 1:1 con Business a propósito: es un conjunto cohesivo con su
// propio ciclo de vida (se genera, se puede regenerar, puede no existir
// todavía), no un puñado de columnas sueltas en Business.
model SeoConfig {
  id              String   @id @default(cuid())
  businessId      String   @unique
  seoTitle        String
  metaDescription String
  h1              String
  ogTitle         String
  ogDescription   String
  // Uso interno únicamente (orientar futuras features) — nunca se renderiza
  // como <meta name="keywords">, eso no aporta nada a Google hoy.
  keywords        String[]
  extraText       String?
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Service {
  id              String        @id @default(cuid())
  businessId      String
  name            String
  description     String?
  category        String?
  durationMinutes Int           @default(60)
  price           Float         @default(0)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Ausente/vacío = comportamiento actual (agenda general del negocio). Un
  // service con filas acá pasa a repartirse entre varios recursos físicos
  // intercambiables (ver Resource) en vez de compartir un único slot.
  resources       ServiceResource[]

  // Único por negocio, no global: dos negocios distintos pueden tener
  // perfectamente un servicio con el mismo nombre. Esto es lo que hace que
  // createService() pueda ser un upsert idempotente — si el training
  // conversacional re-propone "Landing Pages" (ej. por un turno de
  // continuación que repite una sección ya cerrada), converge a la misma
  // fila en vez de crear un duplicado.
  @@unique([businessId, name])
  @@index([businessId])
}

// Recurso físico reservable (cancha, sala, silla, profesional...). Un mismo
// Resource puede prestar servicio a varios Service distintos (ver
// ServiceResource) — ej. "Sala 1" usada tanto para "Consulta" como para
// "Reunión" — así que la disponibilidad siempre se calcula a nivel de
// Resource, nunca a nivel de Service: eso es lo único que garantiza que
// reservar Sala 1 para una Consulta también la bloquee para una Reunión a
// esa hora. Diseñado para poder sumarle más adelante su propio Schedule
// (horario propio por recurso) sin romper nada de lo de acá.
model Resource {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services     ServiceResource[]
  appointments Appointment[]

  @@unique([businessId, name])
  @@index([businessId])
}

// Tabla puente N:M entre Service y Resource.
model ServiceResource {
  serviceId  String
  resourceId String
  createdAt  DateTime @default(now())

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
  @@index([resourceId])
}

model Schedule {
  id         String   @id @default(cuid())
  businessId String
  day        String
  enabled    Boolean  @default(false)
  openTime   String   @default("09:00")
  closeTime  String   @default("18:00")
  hasBreak   Boolean  @default(false)
  breakStart String?
  breakEnd   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
  @@index([businessId])
}

model FAQ {
  id         String   @id @default(cuid())
  businessId String
  question   String
  answer     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model MemoryEntry {
  id         String   @id @default(cuid())
  businessId String
  title      String
  content    String
  category   String
  importance String   @default("medium")
  source     String   @default("manual")
  active     Boolean  @default(true)
  // Presentes solo cuando source = "document" (ver modules/employee/memory.ts
  // createDocumentMemoryEntry). El archivo original vive en Supabase Storage
  // (bucket privado "knowledge-documents", ver lib/knowledge-documents.ts) —
  // acá solo se guarda la referencia/path, nunca el binario. "content" en
  // ese caso es el texto ya extraído del archivo (lo que efectivamente lee
  // el empleado), no el archivo en sí.
  filePath         String?
  fileName         String?
  mimeType         String?
  fileSizeBytes    Int?
  processingStatus String?
  processingError  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, active])
}

model TrainingPlan {
  id          String   @id @default(cuid())
  businessId  String   @unique
  category    String
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sections TrainingPlanSection[]
}

model TrainingPlanSection {
  id          String   @id @default(cuid())
  planId      String
  key         String
  title       String
  description String
  status      String   @default("pending")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId])
}

// ── Training Chat persistence ────────────────────────────────────────────
// Separado a propósito del "conocimiento" (Business/Service/MemoryEntry/etc):
// esto es solo la transcripción de la charla en sí, para que nada se pierda
// aunque la IA no llegue a proponer un guardado. No reutiliza el modelo de
// conversaciones de WhatsApp (son conceptos distintos).

model TrainingConversation {
  id         String   @id @default(cuid())
  businessId String
  mode       String // onboarding | continuous
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages TrainingMessage[]

  @@index([businessId])
  @@index([businessId, mode])
}

model TrainingMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  createdAt      DateTime @default(now())

  conversation TrainingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Appointment {
  id              String    @id @default(cuid())
  businessId      String
  serviceId       String?
  serviceName     String
  // Nullable a propósito: un turno de un servicio sin recursos configurados
  // (el caso de hoy, ej. peluquería) nunca tiene resourceId — sigue
  // funcionando exactamente igual que antes de que existiera este campo. Solo
  // se completa cuando el servicio SÍ usa recursos, con el recurso concreto
  // que quedó asignado (automático o elegido a mano).
  resourceId      String?
  customerName    String
  customerPhone   String
  date            String
  startTime       String
  endTime         String
  durationMinutes Int
  status          String    @default("confirmed")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  business        Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service         Service?  @relation(fields: [serviceId], references: [id])
  resource        Resource? @relation(fields: [resourceId], references: [id])

  @@index([businessId])
  @@index([businessId, date])
  @@index([customerPhone])
  @@index([status])
  @@index([resourceId])
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Employee {
  id              String                @id @default(cuid())
  businessId      String                @unique
  name            String                @default("Asistente")
  role            String                @default("Recepcionista Virtual")
  description     String?
  formality       String                @default("neutral")
  warmth          String                @default("balanced")
  emojiUsage      String                @default("low")
  responseLength  String                @default("medium")
  commercialLevel String                @default("balanced")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  capabilities    EmployeeCapability[]
  goals           EmployeeGoal[]
  restrictions    EmployeeRestriction[]
}

model EmployeeGoal {
  id         String   @id @default(cuid())
  employeeId String
  text       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeRestriction {
  id         String   @id @default(cuid())
  employeeId String
  text       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model EmployeeCapability {
  id         String   @id @default(cuid())
  employeeId String
  key        String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, key])
  @@index([employeeId])
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       String   @default("owner")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}
