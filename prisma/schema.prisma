generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // "crm" incluido a propósito para probar con `prisma validate` si Prisma
  // acepta un schema sin ningún modelo todavía (ver
  // docs/architecture/migracion-schemas-fase3.md, sección C). Si la
  // validación falla por esto, se saca de esta lista hasta que exista el
  // primer modelo real de CRM — NUNCA se borra el schema físico de Postgres
  // por esto, solo esta línea de config de Prisma.
  schemas  = ["public", "nexo", "crm"]
}

model Business {
  id             String   @id @default(cuid())
  name           String
  description    String?
  phone          String?
  address        String?
  category       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  logoUrl        String?
  // URL pública de Supabase Storage (bucket "site-assets") — nunca se guarda
  // el binario ni un base64 acá. Ver lib/site-assets.ts: el path dentro del
  // bucket se deriva de esta URL cuando hace falta (reemplazo, limpieza de
  // huérfanos), así que no hace falta una columna aparte solo para el path.
  heroImageUrl   String?
  // Hex validado en el borde de entrada (ver HEX_COLOR_RE en
  // lib/brand-color.ts) antes de guardarse — nunca se usa un valor crudo del
  // cliente directamente como CSS custom property.
  brandColor     String?
  whatsappNumber String?
  instagramUrl   String?
  facebookUrl    String?
  // URL pública en /s/[slug]. Se genera una sola vez a partir del nombre (ver
  // modules/business/slug.ts) y a propósito NUNCA se regenera sola si el
  // nombre cambia después — cambiar el slug rompería la URL pública ya
  // compartida/indexada. Nullable porque los negocios creados antes de esta
  // feature no tienen uno hasta que se genera de forma perezosa.
  slug           String?  @unique

  // Plantilla del sitio público: "institutional" | "booking" | null. Null
  // (default) = auto-detectar vía getBookingIntent() (ver
  // lib/booking-intent.ts) en vez de guardar un valor fijo que quede
  // desactualizado si el negocio después agrega/saca servicios reservables.
  // Un valor explícito acá es una anulación manual desde Configuración >
  // Sitio (ver sección 13 de la tarea) — nunca se escribe solo.
  siteTemplate String?

  // ── Seña / depósito (ver modules/business/deposit.ts) ──────────────────
  // Configuración global del negocio, no por servicio: cuando depositRequired
  // es true, TODA reserva por turno pasa a pending_payment en vez de
  // confirmarse directo (ver modules/ai/booking/flow.ts). Con
  // depositRequired = false (default), el flujo de reservas sigue
  // exactamente igual que antes de esta feature — ningún campo de acá se lee.
  depositRequired      Boolean @default(false)
  // "fixed" | "percentage" — ver computeDepositAmount() en
  // modules/business/deposit.ts, única fuente de verdad de esta semántica.
  depositType          String?
  depositFixedAmount   Float?
  depositPercentage    Float?
  // Datos bancarios/billetera mostrados al cliente junto con el monto de la
  // seña. Todos opcionales y de texto libre a propósito: no todos los
  // negocios usan los mismos campos (alias vs. CBU vs. wallet), y no tiene
  // sentido forzar a completar uno que no aplica.
  depositAlias         String?
  depositCbu           String?
  depositBankName      String?
  depositAccountHolder String?
  depositTaxId         String?
  depositInstructions  String?

  // ── Carta digital (ver modules/business/menu.ts) ────────────────────────
  // Un solo PDF activo por negocio — mismo criterio que logoUrl/heroImageUrl
  // (campo suelto, no un modelo aparte): no hay historial ni versiones, cada
  // subida reemplaza a la anterior. menuEnabled es independiente de tener un
  // PDF cargado (el dueño puede subir uno y dejarlo apagado hasta estar
  // conforme), pero la página pública y el QR solo se activan con AMBOS.
  menuEnabled Boolean @default(false)
  menuPdfUrl  String?

  appointments          Appointment[]
  employee              Employee?
  faqs                  FAQ[]
  galleryBlocks         GalleryBlock[]
  memberships           Membership[]
  memoryEntries         MemoryEntry[]
  paymentProofs         PaymentProof[]
  resources             Resource[]
  schedules             Schedule[]
  services              Service[]
  trainingPlan          TrainingPlan?
  trainingConversations TrainingConversation[]
  seoConfig             SeoConfig?
  subscription          Subscription?
  notifications         BusinessNotification[]
  inquiries             Inquiry[]
  promoCodeRedemptions  PromoCodeRedemption[]
  convertedFromLeads    Lead[]

  // Entidad del ecosistema Kodexa, no exclusiva de Nexo — ver
  // docs/architecture/migracion-schemas-fase3.md, sección "Business como
  // entidad compartida", para el análisis de qué campos de arriba son
  // conceptualmente específicos de producto (ninguno se separa todavía).
  @@schema("public")
}

// Consulta dejada por un visitante desde el formulario del sitio público
// (ver modules/inquiries/service.ts). Concepto distinto de `Lead` (public):
// ese es el pipeline comercial de Kodexa; esto es una consulta de un cliente
// final hacia UN negocio. El CRM la lee (solo lectura) para generar Leads —
// ver docs/architecture/v1-formulario-consultas-diseno.md.
model Inquiry {
  id               String   @id @default(cuid())
  businessId       String
  customerName     String
  customerWhatsapp String
  customerEmail    String
  message          String
  // NEW | IN_PROGRESS | RESOLVED — ver INQUIRY_STATUSES en
  // lib/schemas.ts (única fuente de verdad del set).
  status           String   @default("NEW")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@schema("nexo")
}

// Centro de notificaciones del dueño (ver modules/notifications/service.ts,
// único punto de escritura). A propósito NO una notificación por cada
// interacción de IA — solo eventos que puedan requerir una acción real:
// nueva reserva, reserva pendiente de confirmación, reserva cancelada,
// comprobante recibido, conversación que necesita un humano, límite de IA
// alcanzado. Arquitectura deliberadamente simple para el MVP (Business →
// BusinessNotification → tipo/payload/readAt), sin tabla por tipo de evento:
// "payload" es JSON libre para lo que cada tipo puntual necesite mostrar
// (ej. nombre del cliente, servicio, horario) sin forzar columnas que la
// mayoría de los tipos no usarían.
model BusinessNotification {
  id           String    @id @default(cuid())
  businessId   String
  // human_required | booking_created | booking_pending | booking_cancelled |
  // payment_proof_received | ai_limit_reached | inquiry_received — ver NOTIFICATION_TYPES en
  // modules/notifications/service.ts (única fuente de verdad del set).
  type         String
  title        String
  body         String
  // Ruta del dashboard donde el dueño puede actuar sobre esto (ej.
  // "/dashboard/turnos"). Null cuando no hay una pantalla puntual a la que
  // mandarlo.
  resourceHref String?
  payload      Json?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, readAt])
  @@index([businessId, createdAt])
  @@schema("nexo")
}

// Bloque visual reutilizable del sitio público (sección "Contenido visual")
// — genérico a propósito, nunca atado a un rubro puntual: un restaurante lo
// usa para "Nuestros platos", una peluquería para "Nuestro espacio". Con
// active = false el bloque se conserva pero desaparece del sitio público sin
// borrar nada (mismo criterio que Resource.active). "order" es un entero
// simple con gaps aceptados (swap entre bloques adyacentes al reordenar, ver
// modules/business/gallery.ts) — no hace falta más que eso para una lista
// que un dueño reordena a mano, nunca miles de filas.
model GalleryBlock {
  id          String   @id @default(cuid())
  businessId  String
  title       String?
  description String?
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  images   GalleryImage[]

  @@index([businessId])
  @@index([businessId, active])
  @@schema("nexo")
}

// N imágenes por bloque (sección 1 de la tarea: "una o varias imágenes").
// Igual que GalleryBlock, "order" es el orden dentro del bloque, reordenado
// por swap entre adyacentes.
model GalleryImage {
  id        String   @id @default(cuid())
  blockId   String
  // URL pública de Storage (bucket "site-assets", kind "gallery" — ver
  // lib/site-assets.ts). Nunca el binario, mismo criterio que el resto de
  // las imágenes del sitio.
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  block GalleryBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@schema("nexo")
}

// Configuración SEO generada por IA a partir de datos reales del negocio —
// nunca se genera en el request público (ver app/s/[slug]/page.tsx), solo se
// LEE ahí. 1:1 con Business a propósito: es un conjunto cohesivo con su
// propio ciclo de vida (se genera, se puede regenerar, puede no existir
// todavía), no un puñado de columnas sueltas en Business.
model SeoConfig {
  id              String   @id @default(cuid())
  businessId      String   @unique
  seoTitle        String
  metaDescription String
  h1              String
  ogTitle         String
  ogDescription   String
  // Uso interno únicamente (orientar futuras features) — nunca se renderiza
  // como <meta name="keywords">, eso no aporta nada a Google hoy.
  keywords        String[]
  extraText       String?
  generatedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@schema("nexo")
}

model Service {
  id              String            @id @default(cuid())
  businessId      String
  name            String
  description     String?
  category        String?
  durationMinutes Int               @default(60)
  price           Float             @default(0)
  active          Boolean           @default(true)
  // URL pública de Supabase Storage (bucket "site-assets", mismo bucket que
  // logo/hero — ver lib/site-assets.ts). Opcional: las cards de servicio del
  // sitio público muestran un fallback visual cuando no hay foto, nunca una
  // imagen inventada.
  imageUrl        String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  appointments    Appointment[]
  business        Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Ausente/vacío = comportamiento actual (agenda general del negocio). Un
  // service con filas acá pasa a repartirse entre varios recursos físicos
  // intercambiables (ver Resource) en vez de compartir un único slot.
  resources       ServiceResource[]

  // Único por negocio, no global: dos negocios distintos pueden tener
  // perfectamente un servicio con el mismo nombre. Esto es lo que hace que
  // createService() pueda ser un upsert idempotente — si el training
  // conversacional re-propone "Landing Pages" (ej. por un turno de
  // continuación que repite una sección ya cerrada), converge a la misma
  // fila en vez de crear un duplicado.
  @@unique([businessId, name])
  @@index([businessId])
  @@schema("nexo")
}

// Recurso físico reservable (cancha, sala, silla, profesional...). Un mismo
// Resource puede prestar servicio a varios Service distintos (ver
// ServiceResource) — ej. "Sala 1" usada tanto para "Consulta" como para
// "Reunión" — así que la disponibilidad siempre se calcula a nivel de
// Resource, nunca a nivel de Service: eso es lo único que garantiza que
// reservar Sala 1 para una Consulta también la bloquee para una Reunión a
// esa hora. Diseñado para poder sumarle más adelante su propio Schedule
// (horario propio por recurso) sin romper nada de lo de acá.
model Resource {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business     Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  services     ServiceResource[]
  appointments Appointment[]

  @@unique([businessId, name])
  @@index([businessId])
  @@schema("nexo")
}

// Tabla puente N:M entre Service y Resource.
model ServiceResource {
  serviceId  String
  resourceId String
  createdAt  DateTime @default(now())

  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([serviceId, resourceId])
  @@index([resourceId])
  @@schema("nexo")
}

model Schedule {
  id         String   @id @default(cuid())
  businessId String
  day        String
  enabled    Boolean  @default(false)
  openTime   String   @default("09:00")
  closeTime  String   @default("18:00")
  hasBreak   Boolean  @default(false)
  breakStart String?
  breakEnd   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, day])
  @@index([businessId])
  @@schema("nexo")
}

model FAQ {
  id         String   @id @default(cuid())
  businessId String
  question   String
  answer     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@schema("nexo")
}

model MemoryEntry {
  id               String   @id @default(cuid())
  businessId       String
  title            String
  content          String
  category         String
  importance       String   @default("medium")
  source           String   @default("manual")
  active           Boolean  @default(true)
  // Presentes solo cuando source = "document" (ver modules/employee/memory.ts
  // createDocumentMemoryEntry). El archivo original vive en Supabase Storage
  // (bucket privado "knowledge-documents", ver lib/knowledge-documents.ts) —
  // acá solo se guarda la referencia/path, nunca el binario. "content" en
  // ese caso es el texto ya extraído del archivo (lo que efectivamente lee
  // el empleado), no el archivo en sí.
  filePath         String?
  fileName         String?
  mimeType         String?
  fileSizeBytes    Int?
  processingStatus String?
  processingError  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([businessId, active])
  @@schema("nexo")
}

model TrainingPlan {
  id          String   @id @default(cuid())
  businessId  String   @unique
  category    String
  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sections TrainingPlanSection[]

  @@schema("nexo")
}

model TrainingPlanSection {
  id          String   @id @default(cuid())
  planId      String
  key         String
  title       String
  description String
  status      String   @default("pending")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, key])
  @@index([planId])
  @@schema("nexo")
}

// ── Training Chat persistence ────────────────────────────────────────────
// Separado a propósito del "conocimiento" (Business/Service/MemoryEntry/etc):
// esto es solo la transcripción de la charla en sí, para que nada se pierda
// aunque la IA no llegue a proponer un guardado. No reutiliza el modelo de
// conversaciones de WhatsApp (son conceptos distintos).

model TrainingConversation {
  id         String   @id @default(cuid())
  businessId String
  mode       String // onboarding | continuous
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  messages TrainingMessage[]

  @@index([businessId])
  @@index([businessId, mode])
  @@schema("nexo")
}

model TrainingMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant
  content        String
  createdAt      DateTime @default(now())

  conversation TrainingConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@schema("nexo")
}

model Appointment {
  id              String         @id @default(cuid())
  businessId      String
  serviceId       String?
  serviceName     String
  // Nullable a propósito: un turno de un servicio sin recursos configurados
  // (el caso de hoy, ej. peluquería) nunca tiene resourceId — sigue
  // funcionando exactamente igual que antes de que existiera este campo. Solo
  // se completa cuando el servicio SÍ usa recursos, con el recurso concreto
  // que quedó asignado (automático o elegido a mano).
  resourceId      String?
  customerName    String
  customerPhone   String
  date            String
  startTime       String
  endTime         String
  durationMinutes Int
  // pending | confirmed | cancelled | completed | no_show | pending_payment |
  // payment_submitted | payment_rejected — los últimos tres solo existen en
  // negocios con Business.depositRequired = true (ver
  // modules/appointments/service.ts, ACTIVE_STATUSES). Reutiliza esta misma
  // columna en vez de un "paymentStatus" separado porque para una reserva con
  // seña el estado del pago ES el estado de la reserva: no queda confirmada
  // hasta que el dueño valida el comprobante.
  status          String         @default("confirmed")
  notes           String?
  // Snapshot al momento de crear el turno (no una referencia viva al precio
  // actual del servicio): si el precio cambia después, un turno pendiente de
  // pago no debe mostrar un monto de seña distinto del que ya se le informó
  // al cliente por WhatsApp. null = este turno no requiere seña.
  depositAmount   Float?
  totalAmount     Float?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  business        Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service         Service?       @relation(fields: [serviceId], references: [id])
  resource        Resource?      @relation(fields: [resourceId], references: [id])
  paymentProofs   PaymentProof[]

  @@index([businessId])
  @@index([businessId, date])
  @@index([customerPhone])
  @@index([status])
  @@index([resourceId])
  @@schema("nexo")
}

// Comprobante de transferencia/pago adjuntado por el cliente vía WhatsApp
// (ver modules/payments/service.ts). Modelo separado (no columnas sueltas en
// Appointment) porque un turno puede tener MÁS DE UNO — si el dueño rechaza
// el primero, el cliente puede reenviar otro, y conservamos el historial
// completo en vez de sobrescribir.
//
// appointmentId es nullable a propósito: cuando llega una imagen y hay más
// de un turno pendiente de pago para el mismo teléfono, no adivinamos a
// cuál corresponde — se sube el archivo (para no perderlo) con
// appointmentId = null y se le pregunta al cliente cuál es; recién ahí se
// completa el vínculo. businessId vive acá aparte (no derivado del
// appointment) para poder scopear y autorizar el acceso incluso en ese
// estado "todavía sin asignar".
model PaymentProof {
  id               String    @id @default(cuid())
  businessId       String
  appointmentId    String?
  // Path dentro del bucket privado "payment-proofs" (ver
  // lib/payment-proofs.ts) — nunca una URL pública ni el binario. El dueño
  // lo ve desde el dashboard vía signed URL de corta duración generada bajo
  // demanda.
  storagePath      String
  originalFileName String?
  mimeType         String
  fileSizeBytes    Int
  // pending | approved | rejected
  status           String    @default("pending")
  uploadedAt       DateTime  @default(now())
  reviewedAt       DateTime?
  // userId de quien validó/rechazó (sesión de Better Auth) — sin relación FK
  // a User a propósito, mismo criterio que AiUsageEvent: esto es un dato de
  // auditoría, no debe poder bloquear ni verse bloqueado por el ciclo de
  // vida de la cuenta.
  reviewedBy       String?
  rejectionReason  String?

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // SetNull (no Cascade): si el turno se borra definitivamente, el
  // comprobante se conserva como evidencia de pago (ver sección 12 de la
  // tarea) — solo pierde el vínculo, no se borra el archivo ni la fila.
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, status])
  @@index([appointmentId])
  @@schema("nexo")
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  accounts      Account[]
  sessions      Session[]

  @@map("user")
  @@schema("public")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
  @@schema("public")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
  @@schema("public")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
  @@schema("public")
}

model Employee {
  id              String                @id @default(cuid())
  businessId      String                @unique
  name            String                @default("Asistente")
  role            String                @default("Recepcionista Virtual")
  description     String?
  formality       String                @default("neutral")
  warmth          String                @default("balanced")
  emojiUsage      String                @default("low")
  responseLength  String                @default("medium")
  commercialLevel String                @default("balanced")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  business        Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  capabilities    EmployeeCapability[]
  goals           EmployeeGoal[]
  restrictions    EmployeeRestriction[]

  @@schema("nexo")
}

model EmployeeGoal {
  id         String   @id @default(cuid())
  employeeId String
  text       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@schema("nexo")
}

model EmployeeRestriction {
  id         String   @id @default(cuid())
  employeeId String
  text       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@schema("nexo")
}

model EmployeeCapability {
  id         String   @id @default(cuid())
  employeeId String
  key        String
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, key])
  @@index([employeeId])
  @@schema("nexo")
}

// Ledger de consumo real de IA — sin relación FK a Business a propósito: es
// una tabla de analítica/costos, no de dominio, y no debe poder bloquear ni
// verse bloqueada por el ciclo de vida de un negocio (ej. no debe impedir
// borrar un Business, y un insert acá nunca debe poder fallar por una FK).
// Se escribe en modules/ai/usage.ts, siempre "best effort" (nunca bloquea ni
// rompe una respuesta de IA si el insert falla). Pensado para poder calcular
// costo real por negocio/operación antes de definir límites por plan (ver
// lib/ai-limits.ts).
model AiUsageEvent {
  id               String   @id @default(cuid())
  businessId       String?
  operation        String // training_onboarding | training_continuous | whatsapp_reply | simulator | seo_generate
  model            String
  promptTokens     Int?
  completionTokens Int?
  success          Boolean  @default(true)
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([operation])
  @@schema("nexo")
}

// ── Planes y suscripciones ───────────────────────────────────────────────
// Reemplaza los límites de IA hardcodeados por env var (ver
// lib/ai-limits.ts, ahora delegado a modules/billing/subscription.ts) por
// una fuente real en Postgres. Preparado para que Mercado Pago sea quien
// cree/actualice Subscription más adelante (provider/providerSubscriptionId
// quedan listos para eso) pero en esta etapa toda asignación es manual desde
// /superadmin/empresas/[id] — sin checkout, sin webhooks, sin cobros.
//
// Billing específico de Nexo (ver docs/architecture/migracion-schemas-fase3.md):
// el CRM tendrá su propio Plan/Subscription dentro de `crm` cuando se
// construya, sin reusar este modelo — no hay billing transversal todavía.

model Plan {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String?
  monthlyPrice Float   @default(0)
  currency     String  @default("ARS")
  // Unidad: cantidad de respuestas de IA permitidas — el mismo significado
  // que tenían ONBOARDING_MAX_AI_RESPONSES/CONTINUOUS_MAX_AI_RESPONSES antes
  // de este cambio, NUNCA tokens. AiUsageEvent sigue siendo la fuente de
  // verdad del consumo en tokens; esa es una medida distinta que se muestra
  // aparte en Superadmin, nunca convertida a créditos ni viceversa. Ver
  // modules/billing/subscription.ts para cómo se aplica este número.
  aiCredits    Int     @default(40)

  // ── Diferenciación comercial más allá de aiCredits ──────────────────────
  // Cada campo está atado a un punto de enforcement real en el código (ver
  // modules/billing/subscription.ts, resolvePlanFeatures()) — nunca se
  // agregó uno "por las dudas". No hay una tabla de features genérica a
  // propósito: con este puñado de columnas alcanza para todo lo que hoy
  // tiene un gate real, y agregar una nueva más adelante es una migración
  // chica, no una reestructuración.
  //
  // null = sin límite (Profesional). No confundir con 0.
  maxServices           Int?
  // Sitio público del negocio (/s/[slug]) y su API de reservas/consultas.
  // false = nivel "Agenda interna": el negocio administra turnos desde el
  // dashboard pero no tiene web pública. Ver isPublicWebEnabled().
  publicWebEnabled      Boolean @default(true)
  whatsappEnabled       Boolean @default(true)
  depositsEnabled       Boolean @default(true)
  customTrainingEnabled Boolean @default(true)
  statsEnabled          Boolean @default(true)
  // Galería de fotos (GalleryBlock) y carta digital + QR (Business.menuEnabled)
  // — nombrado "digitalMenuEnabled" para no colisionar con Business.menuEnabled,
  // que es el switch propio del dueño (independiente del plan).
  galleryEnabled        Boolean @default(true)
  digitalMenuEnabled    Boolean @default(true)

  // ── Mercado Pago (ver modules/billing/mercadopago/) ─────────────────────
  // Agenda interna (monthlyPrice = 0) nunca tiene estos campos poblados — no
  // necesita preapproval_plan. mercadoPagoPlanId es el id del preapproval_plan VIGENTE
  // para nuevas contrataciones: si el precio cambia, se crea un
  // preapproval_plan nuevo en MP y este campo pasa a apuntar a ese id nuevo
  // (la documentación de MP no confirma que transaction_amount se pueda
  // actualizar sobre un plan existente sin afectar a quienes ya lo tienen
  // autorizado — ver sync-plan.ts). Las Subscription ya autorizadas guardan
  // su propio providerSubscriptionId, independiente de este campo, así que
  // "reapuntar" acá nunca las afecta.
  mercadoPagoPlanId       String?   @unique
  // "synced" | "pending" | "error" | null = todavía nunca se intentó
  // sincronizar (plan Gratis, o plan pago recién creado antes del primer
  // intento). Nunca se muestra "sincronizado" en la UI de Superadmin si esto
  // no dice "synced" — ver sección 15 del pedido.
  mercadoPagoSyncStatus   String?
  mercadoPagoLastSyncedAt DateTime?
  mercadoPagoSyncError    String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
  promoCodes    PromoCode[]

  @@schema("nexo")
}

model Subscription {
  id                      String    @id @default(cuid())
  // @unique (no solo un índice): un Business tiene A LO SUMO una
  // Subscription, garantizado por la base — "asignar un plan" siempre es un
  // upsert sobre esta única fila, nunca un insert que pueda competir con
  // otra "activa". Esto es lo que pide la sección "un Business debería tener
  // como máximo una suscripción activa/principal" sin necesitar un índice
  // parcial: no existe una segunda fila con la que inconsistir.
  businessId              String    @unique
  planId                  String
  // trialing | active | past_due | canceled | expired — ver
  // modules/billing/subscription.ts (SUBSCRIPTION_STATUSES) para la
  // semántica de cada uno y qué implica para el acceso a IA.
  status                  String    @default("trialing")
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  // "manual" (asignado desde Superadmin) | "mercadopago" (pago recurrente
  // real, ver modules/billing/mercadopago/) | "promo_code" (canje de un
  // PromoCode) | "benefit" (bonificación temporal otorgada a mano desde
  // /superadmin/empresas — ver grantTemporaryPlan() más abajo). Todos pasan
  // por assignSubscription() tal cual, nunca una segunda lógica de
  // suscripciones. Mercado Pago es la fuente de verdad del COBRO cuando
  // provider = "mercadopago"; Nexo sigue siendo la fuente de verdad de qué
  // implica ese estado (gating, créditos IA) vía resolveAiAccess/
  // resolvePlanFeatures, que nunca miran mercadoPagoStatus directamente.
  provider                String?
  // Reutilizado tal cual como el id del preapproval de Mercado Pago cuando
  // provider = "mercadopago" — nunca se agregó un mercadoPagoSubscriptionId
  // aparte, este campo ya cumplía exactamente ese rol desde que existe.
  providerSubscriptionId  String?
  // Estado CRUDO devuelto por Mercado Pago (pending|authorized|paused|cancelled)
  // — separado a propósito de "status" de arriba: "status" es el vocabulario
  // interno de Nexo (trialing/active/past_due/canceled/expired) que ya
  // entienden resolveAiAccess/resolvePlanFeatures; este campo es solo para
  // mostrar/depurar el valor real de MP sin traducir, nunca se lee para
  // decidir gating. Ver mapMercadoPagoStatus() para el mapping documentado.
  mercadoPagoStatus       String?
  mercadoPagoLastSyncedAt DateTime?
  // Bonificación temporal en curso (otorgada a mano o vía PromoCode): no
  // null = esta Subscription debe revertirse a previousPlanId cuando
  // benefitExpiresAt pase — ver revertExpiredBenefits() en
  // modules/billing/subscription.ts, corrida por
  // app/api/cron/revert-expired-benefits. Ambos vuelven a null en cuanto se
  // revierte, o si alguien vuelve a asignar el plan a mano (assignSubscription
  // sin pasar estos campos los limpia — una asignación manual directa
  // cancela cualquier reversión automática pendiente). previousPlanId es un
  // id suelto (sin FK, mismo criterio que PaymentProof.reviewedBy): es un
  // snapshot de a qué volver, no debe poder bloquear ni verse bloqueado por
  // el ciclo de vida de ese Plan. Nunca se setean para provider="mercadopago"
  // — un beneficio/promo y una suscripción paga son conceptos separados
  // (sección 9/17/18 del pedido).
  benefitExpiresAt        DateTime?
  previousPlanId          String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // Sin onDelete: Cascade a propósito — borrar un Plan mientras tenga
  // Subscriptions debe fallar (comportamiento default de Postgres), nunca
  // arrastrar suscripciones activas a un plan borrado. La UI de Superadmin
  // ni siquiera expone un borrado físico: solo activar/desactivar.
  plan     Plan     @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
  @@index([benefitExpiresAt])
  @@schema("nexo")
}

// Idempotencia de POST /api/webhooks/mercadopago (Fase 4): Mercado Pago
// reintenta una notificación hasta recibir 200, así que el mismo evento
// puede llegar más de una vez. `id` es el id de notificación que manda MP en
// el body del webhook (no data.id, que es el id del preapproval/pago) — un
// segundo intento con el mismo id choca contra el @id y el handler corta ahí
// sin reprocesar. Fila de auditoría liviana, nunca se borra ni se lee para
// nada más que este chequeo.
model MercadoPagoWebhookEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())

  @@schema("nexo")
}

// ── Códigos promocionales ────────────────────────────────────────────────
// Permite "regalar" un plan por un período determinado sin que Superadmin
// tenga que tocar la Subscription de cada negocio a mano (ver
// modules/promo-codes/service.ts). Nunca se borra un PromoCode ni una
// PromoCodeRedemption — el historial de canjes es la fuente de verdad de
// "quién usó qué código, cuándo, y hasta cuándo quedó bonificado" (sección 5
// del pedido). Un código de un solo uso simplemente queda agotado
// (usedCount alcanza maxUses), nunca se marca "usado" borrándolo.
model PromoCode {
  id           String   @id @default(cuid())
  // Siempre mayúsculas (normalizado en el servicio, no acá) — @unique es la
  // fuente real de "no puede haber dos códigos iguales".
  code         String   @unique
  planId       String
  // Días de bonificación, no "meses" — el mes calendario es ambiguo (28-31
  // días) y la UI de Superadmin ofrece presets (30/60/90/180/365 = 1/2/3/6/
  // 12 meses) más un valor custom en días, todos representables acá sin
  // introducir un segundo tipo de dato.
  durationDays Int
  // null = sin límite de usos. No confundir con 0 (0 sería un código que
  // nunca se puede usar, no tiene sentido crearlo así — la UI no lo permite).
  maxUses      Int?
  usedCount    Int      @default(0)
  expiresAt    DateTime
  active       Boolean  @default(true)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // RESTRICT (default): un Plan con códigos activos no se borra — mismo
  // criterio que Subscription.plan.
  plan        Plan                  @relation(fields: [planId], references: [id])
  redemptions PromoCodeRedemption[]

  @@index([active])
  @@schema("nexo")
}

// Un canje = un uso. appointmentId/etc no aplica acá — el vínculo relevante
// es businessId (quién recibió el beneficio) y userId (qué usuario de ese
// negocio lo aplicó, sesión de better-auth). Nunca se actualiza ni se borra
// después de creado: es un log de auditoría, igual criterio que
// PaymentProof/AiUsageEvent en este mismo schema.
model PromoCodeRedemption {
  id               String   @id @default(cuid())
  promoCodeId      String
  businessId       String
  // userId de quien aplicó el código (sesión) — sin relación FK a User a
  // propósito, mismo criterio que PaymentProof.reviewedBy: un dato de
  // auditoría que no debe poder bloquear ni verse bloqueado por el ciclo de
  // vida de la cuenta.
  userId           String
  // Snapshot del nombre del plan al momento del canje — si el Plan cambia de
  // nombre después, el historial sigue mostrando lo que realmente se
  // otorgó (mismo criterio que Appointment.depositAmount/totalAmount).
  planNameSnapshot String
  bonusExpiresAt   DateTime
  redeemedAt       DateTime @default(now())

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id])
  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([promoCodeId])
  @@index([businessId])
  @@schema("nexo")
}

// ── Leads comerciales (landing) ──────────────────────────────────────────
// Captación simple, no un CRM: un visitante de la landing sin cuenta manda
// el formulario de evaluación (ver app/api/leads/route.ts, público, sin
// auth) y esto queda acá para que Superadmin lo trabaje manualmente. Un Lead
// puede existir toda su vida sin volverse nunca un Business real — no hay
// ninguna creación automática de Business desde este modelo (ver sección 9
// del pedido).
//
// Vive en `public`, no en `nexo` ni en `crm` (ver
// docs/architecture/migracion-schemas-fase2.md, sección B "Lead — decisión
// dedicada", confirmado por decisión explícita en Fase 3): es pipeline
// comercial de Kodexa, no una feature de ningún producto — no confundir con
// el futuro concepto de Lead del CRM (que será de clientes de un Business,
// no de Kodexa).
model Lead {
  id            String   @id @default(cuid())
  name          String
  businessName  String
  whatsapp      String
  email         String
  // Texto libre — mismo criterio que Business.category (ver comentario ahí):
  // el <Select> de la landing restringe a BUSINESS_CATEGORIES, pero la
  // columna no fuerza esa lista cerrada.
  industry      String
  // Array nativo de Postgres (Prisma soporta String[] directo, sin tabla de
  // unión) — valores válidos en LEAD_GOALS (lib/types.ts). "Qué querés
  // mejorar" es multi-selección a propósito: un negocio real casi siempre
  // marca más de una opción.
  goals         String[]
  // "under_20" | "20_50" | "50_100" | "over_100" | "unknown" — ver
  // LEAD_MONTHLY_VOLUMES en lib/types.ts. Nullable: la pregunta es opcional
  // de responder en el form (nunca se fuerza a adivinar un número).
  monthlyVolume String?
  message       String?
  wantsMeeting  Boolean  @default(false)
  // NEW | CONTACTED | MEETING | PROPOSAL | CONVERTED | LOST — String, no
  // enum de Prisma: mismo criterio que Appointment.status/Subscription.status
  // en este mismo schema, nunca se usó `enum` acá. Ver LEAD_STATUSES.
  status        String   @default("NEW")
  // Slug de Plan ("gratis"|"esencial"|"profesional"), nunca una FK — es una
  // sugerencia calculada por reglas simples (ver
  // modules/leads/suggest-plan.ts), no una asignación real de plan. Si el
  // Plan se borra/renombra después, el historial del lead no debe romperse.
  suggestedPlan String?
  // Notas internas de seguimiento — solo las ve Superadmin, nunca el lead.
  notes         String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  contactedAt DateTime?
  meetingAt   DateTime?
  convertedAt DateTime?

  // Vínculo opcional si el lead se convirtió en un Business real ya
  // existente (sección 9 del pedido: Superadmin lo relaciona a mano eligiendo
  // uno existente — este modelo NUNCA crea un Business). SetNull: si ese
  // Business se borra después, el lead conserva su historial, solo pierde
  // el vínculo.
  convertedBusinessId String?
  convertedBusiness   Business? @relation(fields: [convertedBusinessId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([convertedBusinessId])
  @@schema("public")
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       String   @default("owner")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
  @@schema("public")
}
