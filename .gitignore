# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# whatsapp sessions
/.whatsapp-sessions/

# volcados de datos reales tomados como red de seguridad antes de migraciones
# de base de datos (contienen PII de clientes: emails, teléfonos, nombres) —
# nunca deben commitearse. Ver docs/architecture/migracion-schemas-fase3.md.
/prisma/_backup_pre_*/

# typescript
*.tsbuildinfo
next-env.d.ts
