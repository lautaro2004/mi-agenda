# Nexo — variables de entorno (plantilla). Copiar a .env.local y completar.
# NUNCA commitear valores reales: .env y .env.local están en .gitignore.

# ── Base de datos (Supabase Postgres) ─────────────────────────────────────
# DATABASE_URL: pooler transaccional (puerto 6543), usada en runtime.
# DIRECT_URL: session pooler (puerto 5432), usada solo por el Prisma CLI.
DATABASE_URL=
DIRECT_URL=

# ── Better Auth ───────────────────────────────────────────────────────────
# BETTER_AUTH_URL debe ser la URL pública real: de ahí salen los enlaces de
# los emails de verificación y recuperación de contraseña.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# ── Supabase Storage (solo servidor; no se usa la Data API) ───────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Gemini ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=

# ── Cron interno ──────────────────────────────────────────────────────────
# Protege /api/cron/* (Authorization: Bearer <valor>). El mismo valor va en el
# secret CRON_SECRET del repo de GitHub para el workflow email-cron.yml.
CRON_SECRET=

# ── Superadmin ────────────────────────────────────────────────────────────
# Allowlist de emails con acceso a /superadmin, separados por comas.
SUPERADMIN_EMAILS=

# ── Emails (Resend) ───────────────────────────────────────────────────────
# Cuenta de Kodexa. Sin RESEND_API_KEY el envío se simula (no llega nada).
RESEND_API_KEY=
# Remitente de la plataforma. El dominio debe estar verificado en Resend.
# Por defecto: Nexo <contacto@kodexa.ar>
EMAIL_FROM=

# ── Mercado Pago ──────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# ── Google (Gmail / Calendar) ─────────────────────────────────────────────
# UN solo cliente OAuth de Kodexa para Nexo y Nodo (ver
# nexo/docs/architecture/google-integration.md). Sin estas variables, la
# conexión con Google queda deshabilitada y los emails salen por Resend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Redirect URI de ESTA app (Nexo); cada app tiene la suya y las dos deben
# estar registradas en el cliente OAuth de Google. Ej: https://<dominio-nexo>/api/integrations/google/callback
GOOGLE_REDIRECT_URI=
# Clave AES-256-GCM (32 bytes en base64) para cifrar el refresh token. DEBE ser
# el MISMO valor en Nexo y Nodo (comparten la tabla GoogleConnection).
# Generar con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
